<% if Docuseal.demo? || (request.path != '/' && !devise_controller?) %>
  <meta name="robots" content="noindex">
<% end %>
<% title = content_for(:html_title) || 'DIELCA · Portal de firmas' %>
<% description = content_for(:html_description) || 'Portal de DIELCA para completar y firmar documentos.' %>
<meta name="description" content="<%= description %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:type" content="website">
<meta property="og:url" content="<%= root_url %>">
<meta property="og:site_name" content="DIELCA">
<% if content_for(:disable_image_preview) %>
  <meta property="og:image" content="">
  <meta name="twitter:image" content="">
<% else %>
  <meta property="og:image" content="<%= content_for(:preview_image_url).presence || "#{root_url}dielca/logo.png" %>">
  <meta name="twitter:image" content="<%= content_for(:preview_image_url).presence || "#{root_url}dielca/logo.png" %>">
<% end %>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= description %>">
<link rel="icon" type="image/svg+xml" href="/dielca/favicon.svg">
<meta name="theme-color" content="#2b2f88">
