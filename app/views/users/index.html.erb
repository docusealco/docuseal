<% content_for(:native_title, params[:status] == 'archived' ? t('archived_users') : (params[:status] == 'integration' ? t('embedding_users') : t('users'))) if turbo_native_app? %>
<div class="flex-wrap space-y-4 md:flex md:flex-nowrap md:space-y-0 md:space-x-10">
  <%= render 'shared/settings_nav' %>
  <div class="md:flex-grow">
    <div class="flex flex-wrap items-center md:items-end gap-x-4 gap-y-2 mb-4 min-h-12">
      <h1 class="text-3xl md:text-4xl font-bold truncate min-w-0 mr-auto md:order-1">
        <% if params[:status] == 'archived' %>
          <%= t('archived_users') %>
        <% elsif params[:status] == 'integration' %>
          <%= t('embedding_users') %>
        <% else %>
          <%= t('users') %>
        <% end %>
      </h1>
      <% if params[:status].blank? %>
        <% if can?(:create, User.new(account: current_account)) %>
          <%= link_to new_user_path, class: 'shrink-0 md:order-3 btn btn-primary btn-md gap-2', title: t('new_user'), data: { turbo_frame: 'modal' } do %>
            <%= svg_icon('plus', class: 'w-6 h-6') %>
            <span class="md:hidden"><%= t('new') %></span>
            <span class="hidden md:inline"><%= t('new_user') %></span>
          <% end %>
        <% else %>
          <div class="shrink-0 md:order-3 md:tooltip" data-tip="<%= t('contact_your_administrator_to_add_new_users') %>">
            <%= link_to '#', class: 'btn btn-primary btn-md gap-2 btn-disabled', title: t('new_user'), data: { turbo_frame: 'modal' } do %>
              <%= svg_icon('plus', class: 'w-6 h-6') %>
              <span class="md:hidden"><%= t('new') %></span>
              <span class="hidden md:inline"><%= t('new_user') %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
      <% if params[:status].blank? && can?(:create, User.new(account: current_account)) %>
        <div class="basis-full md:basis-auto md:order-2 flex flex-col md:flex-row gap-y-2 gap-x-4 md:items-center">
          <%= render 'users/extra_buttons' %>
        </div>
      <% end %>
    </div>
    <div class="md:hidden divide-y divide-base-300">
      <% @users.each do |user| %>
        <% can_edit = params[:status].blank? && can?(:update, user) && user.archived_at.blank? %>
        <% can_remove = params[:status] != 'archived' && can?(:destroy, user) && user != current_user %>
        <% can_unarchive = params[:status] == 'archived' && can?(:create, user) && user != current_user && user.archived_at? %>
        <div class="flex items-center gap-3 py-4">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-base-300 text-sm">
            <%= user.initials.presence || user.email.first.upcase %>
          </span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-semibold truncate"><%= user.full_name.presence || user.email %></span>
              <span class="badge badge-info badge-outline badge-sm whitespace-nowrap shrink-0"><%= t(user.role) %></span>
            </div>
            <% if user.try(:pending_reconfirmation?) %>
              <div class="text-sm text-base-content/70 truncate"><%= user.unconfirmed_email %> (<%= t('unconfirmed') %>)</div>
            <% elsif user.full_name.present? %>
              <div class="text-sm text-base-content/70 truncate"><%= user.email %></div>
            <% end %>
          </div>
          <% if can_edit || can_remove || can_unarchive %>
            <native-menu class="<%= 'dropdown dropdown-end' unless turbo_native_app? %>">
              <label tabindex="0" aria-label="<%= t('more') %>" class="btn btn-ghost btn-circle btn-sm">
                <%= svg_icon('dots_vertical', class: 'w-5 h-5') %>
              </label>
              <ul tabindex="0" class="<%= turbo_native_app? ? 'hidden' : 'z-10 dropdown-content p-2 mt-2 shadow menu bg-base-100 rounded-box min-w-[160px]' %>">
                <% if can_edit %>
                  <li>
                    <native-menu-action data-icon="pencil" data-label="<%= t('edit') %>">
                      <%= link_to edit_user_path(user), class: 'flex items-center gap-2', data: { turbo_frame: 'modal' } do %>
                        <%= svg_icon('pencil', class: 'w-5 h-5 flex-shrink-0') %>
                        <span><%= t('edit') %></span>
                      <% end %>
                    </native-menu-action>
                  </li>
                <% end %>
                <% if can_remove %>
                  <li>
                    <native-menu-action data-icon="trash" data-label="<%= t('remove') %>" data-destructive="true">
                      <button form="<%= dom_id(user, :remove) %>" class="flex items-center gap-2 w-full text-error" data-turbo-confirm="<%= t('are_you_sure_') %>">
                        <%= svg_icon('trash', class: 'w-5 h-5 flex-shrink-0') %>
                        <span><%= t('remove') %></span>
                      </button>
                      <%= button_to '', user_path(user), method: :delete, form: { id: dom_id(user, :remove) }, form_class: 'hidden' %>
                    </native-menu-action>
                  </li>
                <% end %>
                <% if can_unarchive %>
                  <li>
                    <native-menu-action data-icon="rotate" data-label="<%= t('unarchive') %>">
                      <button form="<%= dom_id(user, :unarchive) %>" class="flex items-center gap-2 w-full" data-turbo-confirm="<%= t('are_you_sure_') %>">
                        <%= svg_icon('rotate', class: 'w-5 h-5 flex-shrink-0') %>
                        <span><%= t('unarchive') %></span>
                      </button>
                      <%= button_to '', user_path(user), method: :put, params: { user: { archived_at: nil } }, form: { id: dom_id(user, :unarchive) }, form_class: 'hidden' %>
                    </native-menu-action>
                  </li>
                <% end %>
              </ul>
            </native-menu>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="hidden md:block overflow-x-auto">
      <table class="table w-full table-lg rounded-b-none overflow-hidden">
        <thead class="bg-base-200">
          <tr class="text-neutral uppercase">
            <th>
              <%= t('name') %>
            </th>
            <th>
              <%= t('email') %>
            </th>
            <th>
              <%= t('role') %>
            </th>
            <th>
              <%= t('last_session') %>
            </th>
            <th class="text-right" width="1px">
            </th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <%= user.full_name %>
              </td>
              <td>
                <% if user.try(:pending_reconfirmation?) %>
                  <%= user.unconfirmed_email %>
                  <br>
                  <span class="label-text-alt">(<%= t('unconfirmed') %>)</span>
                <% else %>
                  <%= user.email %>
                <% end %>
              </td>
              <td>
                <span class="badge badge-info badge-outline whitespace-nowrap">
                  <%= t(user.role) %>
                </span>
              </td>
              <td>
                <%= user.current_sign_in_at ? l(user.current_sign_in_at.in_time_zone(current_account.timezone), format: :short, locale: current_account.locale) : '-' %>
              </td>
              <td class="flex items-center space-x-2 justify-end">
                <% if params[:status].blank? && can?(:update, user) && user.archived_at.blank? %>
                  <%= link_to edit_user_path(user), class: 'btn btn-outline btn-xs', title: t('edit'), data: { turbo_frame: 'modal' } do %>
                    <%= t('edit') %>
                  <% end %>
                <% end %>
                <% if params[:status] != 'archived' && can?(:destroy, user) && user != current_user %>
                  <%= button_to user_path(user), method: :delete, class: 'btn btn-outline btn-error btn-xs', title: t('remove'), data: { turbo_confirm: t('are_you_sure_') } do %>
                    <%= t('remove') %>
                  <% end %>
                <% end %>
                <% if params[:status] == 'archived' && can?(:create, user) && user != current_user && user.archived_at? %>
                  <%= button_to user_path(user), method: :put, params: { user: { archived_at: nil } }, class: 'btn btn-outline btn-xs', title: t('unarchive'), data: { turbo_confirm: t('are_you_sure_') } do %>
                    <%= t('unarchive') %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy.pages > 1 %>
      <%= render 'shared/pagination', pagy: @pagy, items_name: 'users', left_additional_html: render('bottom_links') %>
    <% else %>
      <div class="mt-2">
        <%= render 'bottom_links' %>
      </div>
    <% end %>
  </div>
</div>
