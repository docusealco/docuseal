<% query_params = params.permit(:q, :scope, :archived).merge(filter_params) %>
<% advanced_filters = filter_params.then { |f| f[:status].in?(%w[pending completed]) ? f.except(:status) : f } %>
<native-menu class="<%= turbo_native_app? ? 'block' : 'dropdown dropdown-end' %> shrink-0">
  <label tabindex="0" class="cursor-pointer flex h-10 py-1 text-lg items-center border text-center text-neutral rounded-xl hover:border-neutral-700 <%= advanced_filters.present? ? 'w-10 md:w-auto px-0 md:px-3 space-x-0 md:space-x-1 justify-center md:justify-between border-neutral-700 md:border-neutral-300' : 'px-3 space-x-1 justify-between border-neutral-300' %>">
    <%= svg_icon('filter', class: 'w-5 h-5 flex-shrink-0 stroke-2') %>
    <% if advanced_filters.blank? %>
      <span>Filter</span>
    <% end %>
  </label>
  <ul tabindex="0" class="<%= turbo_native_app? ? 'hidden' : 'z-10 dropdown-content p-2 mt-2 shadow menu text-base bg-base-100 rounded-box text-right' %>" style="min-width: 180px;">
    <li class="flex">
      <native-menu-action data-icon="calendar_check" data-label="<%= t('completed_at') %>">
        <%= link_to submissions_filter_path('completed_at', query_params.merge(path: url_for)), class: 'flex items-center gap-2', data: { turbo_frame: 'modal', native_modal: 'medium' } do %>
          <%= svg_icon('calendar_check', class: 'w-5 h-5 flex-shrink-0 stroke-2') %>
          <span><%= t('completed_at') %></span>
        <% end %>
      </native-menu-action>
    </li>
    <li class="flex">
      <native-menu-action data-icon="calendar" data-label="<%= t('created_at') %>">
        <%= link_to submissions_filter_path('created_at', query_params.merge(path: url_for)), class: 'flex items-center gap-2', data: { turbo_frame: 'modal', native_modal: 'medium' } do %>
          <%= svg_icon('calendar', class: 'w-5 h-5 flex-shrink-0 stroke-2') %>
          <span><%= t('created_at') %></span>
        <% end %>
      </native-menu-action>
    </li>
    <li class="flex">
      <native-menu-action data-icon="info_circle" data-label="<%= t('status') %>">
        <%= link_to submissions_filter_path('status', query_params.merge(path: url_for)), class: 'flex items-center gap-2', data: { turbo_frame: 'modal', native_modal: 'medium' } do %>
          <%= svg_icon('info_circle', class: 'w-5 h-5 flex-shrink-0 stroke-2') %>
          <span><%= t('status') %></span>
        <% end %>
      </native-menu-action>
    </li>
    <li class="flex">
      <native-menu-action data-icon="folder" data-label="<%= t('folder') %>">
        <%= link_to submissions_filter_path('folder', query_params.merge(path: url_for)), class: 'flex items-center gap-2', data: { turbo_frame: 'modal', native_modal: 'medium' } do %>
          <%= svg_icon('folder', class: 'w-5 h-5 flex-shrink-0 stroke-2') %>
          <span><%= t('folder') %></span>
        <% end %>
      </native-menu-action>
    </li>
    <li class="flex">
      <native-menu-action data-icon="user" data-label="<%= t('author') %>">
        <%= link_to submissions_filter_path('author', query_params.merge(path: url_for)), class: 'flex items-center gap-2', data: { turbo_frame: 'modal', native_modal: 'medium' } do %>
          <%= svg_icon('user', class: 'w-5 h-5 flex-shrink-0 stroke-2') %>
          <span><%= t('author') %></span>
        <% end %>
      </native-menu-action>
    </li>
  </ul>
</native-menu>
