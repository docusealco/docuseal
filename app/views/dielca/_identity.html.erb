<aside class="dielca-identity" aria-label="Portal corporativo DIELCA">
  <div class="dielca-identity-inner">
    <div class="dielca-brand">
      <% if Rails.public_path.join('dielca/logo.png').file? %>
        <img src="/dielca/logo.png?v=<%= Rails.public_path.join('dielca/logo.png').mtime.to_i %>" alt="DIELCA" class="dielca-logo" width="1617" height="355">
      <% else %>
        <span class="dielca-wordmark">DIELCA</span>
      <% end %>
    </div>
  </div>
</aside>
